{
  "name": "zero-to",
  "version": "0.0.0",
  "private": true,
  "description": "Type /zero-to <topic> in a coding agent and get a learning roadmap you can walk: a 3D trail map with stages, checkpoints, verified resources and saved progress.",
  "license": "Apache-2.0",
  "author": "OthmanAdi",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "prerender": "node --experimental-strip-types scripts/prerender.ts",
    "og-images": "node --experimental-strip-types scripts/og-images.ts",
    "build:skill": "node scripts/build-skill.ts",
    "build:viewer": "node scripts/build-viewer.ts"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/three": "0.187.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
